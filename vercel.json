{
  "version": 2,
  "routes": [
    {
      "src": "/api/webhook",
      "dest": "/api/webhook.js",
      "methods": ["POST"]
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1.js"
    },
    {
      "src": "/song/(.*)",
      "dest": "/song.html"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
