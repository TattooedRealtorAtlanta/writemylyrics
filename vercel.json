{
  "version": 2,
  "routes": [
    {
      "src": "/api/webhook",
      "dest": "/api/webhook.js",
      "methods": ["POST"]
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1.js"
    },
    {
      "src": "/admin",
      "dest": "/admin.html"
    },
    {
      "src": "/song/(.*)",
      "dest": "/song.html"
    },
    {
      "src": "/how-to",
      "dest": "/how-to.html"
    },
    {
      "src": "/privacy",
      "dest": "/privacy-policy.html"
    },
    {
      "src": "/terms",
      "dest": "/terms-of-service.html"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
